# Copia este archivo a .env y reemplaza todos los valores.
REDIS_PASSWORD=generate-a-long-random-password
REDIS_URL=redis://:generate-a-long-random-password@localhost:6379
SESSION_BINDING_SECRET=generate-a-long-random-secret
ADMIN_DASHBOARD_KEY=generate-a-long-admin-key
TRUST_PROXY=false
# Redis solo se publica en localhost por defecto.
REDIS_PORT=6379
